  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "This page may have moved. Go to the [documentation home](/) or pick a project from the switcher above."
    }
  },
  "redirects": [
    {
      "source": "/getting-started/:slug*",
      "destination": "/research-agent-skills/getting-started/:slug*",
      "permanent": true
    },
    {
      "source": "/guides/:slug*",
      "destination": "/research-agent-skills/guides/:slug*",
      "permanent": true
    },
    {
      "source": "/skills",
      "destination": "/research-agent-skills/skills",
      "permanent": true
    },
    {
      "source": "/skills/:slug*",
      "destination": "/research-agent-skills/skills/:slug*",
      "permanent": true
    },
    {
      "source": "/reference/:slug*",
      "destination": "/research-agent-skills/reference/:slug*",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/research-agent-skills/faq",
      "permanent": true
    }
  ],
  "seo": {
    "indexing": "all"
  }
