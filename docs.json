{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Kalaris Labs Docs",
  "description": "Documentation for Kalaris Labs projects and tools.",
  "theme": "maple",
  "colors": {
    "primary": "#165D74",
    "light": "#69C3D6",
    "dark": "#1B7894"
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "/"
